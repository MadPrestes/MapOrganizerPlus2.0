<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Preview visual do layout"
    Height="760"
    Width="1200"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">

            <TextBlock
                Name="txtPreviewInfo"
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                Foreground="#D4D4D4"/>

            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal">

                <Button
                    Name="btnFitPreview"
                    Content="Panorama"
                    Width="100"
                    Margin="0,0,10,0"/>

                <TextBlock
                    Text="Zoom"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"/>

                <Slider
                    Name="sldPreviewZoom"
                    Width="180"
                    Minimum="0.25"
                    Maximum="3"
                    Value="1"
                    TickFrequency="0.25"
                    IsSnapToTickEnabled="True"/>

                <TextBlock
                    Name="txtPreviewZoom"
                    Width="48"
                    Text="100%"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"/>

            </StackPanel>

        </DockPanel>

        <Border
            Grid.Row="1"
            BorderBrush="#4E4E4E"
            BorderThickness="1"
            Background="#1E1E1E">

            <ScrollViewer
                Name="svPreview"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Canvas
                    Name="cnvPreview"
                    Background="#252526"/>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>
