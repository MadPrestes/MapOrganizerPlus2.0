<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sincronizar mapa com grupo"
    Height="700"
    Width="1050"
    WindowStartupLocation="CenterOwner"
    Background="#1E1E1E"
    Foreground="#D4D4D4">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Sincronizar mapa com grupo"
            FontSize="22"
            FontWeight="Bold"
            Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Mapa:" VerticalAlignment="Center" Foreground="#D4D4D4"/>
            <ComboBox
                Grid.Column="1"
                Name="cmbSyncMaps"
                Margin="8,0,18,0"
                IsEditable="False"/>

            <Label Grid.Column="2" Content="Grupo:" VerticalAlignment="Center" Foreground="#D4D4D4"/>
            <ComboBox
                Grid.Column="3"
                Name="cmbSyncGroups"
                Margin="8,0,18,0"
                IsEditable="False"/>

            <Label Grid.Column="4" Content="Colunas:" VerticalAlignment="Center" Foreground="#D4D4D4"/>
            <ComboBox
                Grid.Column="5"
                Name="cmbSyncColumns"
                Margin="8,0,0,0"
                IsEditable="False"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button
                Name="btnCompareSync"
                Content="Comparar"
                Width="120"
                Height="30"/>

            <Button
                Name="btnApplySync"
                Content="Adicionar faltantes"
                Width="150"
                Height="30"
                Margin="10,0,0,0"
                IsEnabled="False"/>

            <ProgressBar
                Name="pgSync"
                Width="220"
                Height="5"
                Margin="15,13,0,0"
                Minimum="0"
                Maximum="100"
                Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Name="txtSyncStatus"
                Grid.Row="0"
                Text="Selecione um mapa e um grupo para comparar."
                Margin="0,0,0,8"/>

            <DataGrid
                Name="gridSync"
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Foreground" Value="#D4D4D4"/>
                        <Setter Property="BorderBrush" Value="#4E4E4E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome do host" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Host ID" Binding="{Binding HostId}" Width="120"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
